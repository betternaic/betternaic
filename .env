# Public build-time settings (bundled into the client, so never put secrets here).
# Generated with `npm run setup` (the starter kit's setup tool), then edited.
# Private overrides go in .env.local, which is git-ignored.

VITE_GOVERNMENT_NAME="Naic, Cavite"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Region IV-A (CALABARZON)"
VITE_PROVINCE="Cavite"

VITE_SITE_NAME="BetterNaic"
VITE_WEBSITE_URL="https://betternaic.vercel.app"
VITE_SITE_DESCRIPTION="BetterNaic is a volunteer-run portal for Naic, Cavite: municipal services and requirements, elected officials, the 30 barangays, emergency hotlines, tourism, and transparency links in one place."
VITE_SITE_KEYWORDS="Naic, Naic Cavite, Bayan ng Naic, Naic municipal hall, Naic services, Naic barangays, Naic officials, Cavite"
VITE_OG_IMAGE_URL="https://betternaic.vercel.app/og-image.jpg"

VITE_FACEBOOK_URL="https://facebook.com/betternaic"
VITE_GITHUB_URL="https://github.com/riecodes/betternaic"

# Cloudflare Worker API (reports, announcements, moderator login).
VITE_API_URL="https://betternaic-api.eirmonpaculan11.workers.dev"
# Cloudflare Turnstile site key (public). .env.development swaps in the
# always-pass test key for local work.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAFYbTaximfje19hX"
